# Cross-venue observation poller config — copy to .env (gitignored) and edit.
# All values shown are the defaults if unset.

# Comma-separated venue names, must match a key registered in poller.py's
# _READERS (currently just "bisq" — Eigen ASB/Haveno get added here once built).
VENUES_ENABLED=bisq

# Comma-separated FROM/TO pairs to observe on every enabled venue.
VENUES_PAIRS=xmr/btc

# Seconds between polls when run with --loop.
VENUES_POLL_INTERVAL_SECONDS=300

# Per-request HTTP timeout, seconds.
VENUES_REQUEST_TIMEOUT_SECONDS=10

# SQLite file — lives outside this repo by default, alongside BasicSwap's own
# runtime data and its separate basicswap_observations.db.
VENUES_DB_PATH=~/coinswaps/venue_observations.db
