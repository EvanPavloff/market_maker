# Cross-venue observation poller config — copy to .env (gitignored) and edit.
# All values shown are the defaults if unset.

# Comma-separated venue names, must match a key registered in poller.py's
# _READERS (currently "bisq", "eigen_asb", and the instant-swap quote services
# "exolix" and "changenow" — Haveno gets added here once built).
VENUES_ENABLED=bisq,eigen_asb,exolix,changenow

# Instant-swap venues: BTC size each poll asks a quote for (~0.5 XMR, the
# restock leg's top-up size). Bisq/Eigen ASB ignore it.
VENUES_QUOTE_PROBE_BTC=0.0032

# Comma-separated FROM/TO pairs to observe on every enabled venue.
VENUES_PAIRS=xmr/btc

# Seconds between polls when run with --loop.
VENUES_POLL_INTERVAL_SECONDS=300

# Per-request HTTP timeout, seconds (Bisq only -- Eigen ASB has its own knobs below).
VENUES_REQUEST_TIMEOUT_SECONDS=10

# SQLite file — lives outside this repo by default, alongside BasicSwap's own
# runtime data and its separate basicswap_observations.db.
VENUES_DB_PATH=~/coinswaps/venue_observations.db

# Eigen ASB: path to the compiled fetch_quotes_json binary (built from
# ~/eigenwallet-core, a permanent sibling to BasicSwap's own ~/coinswaps --
# see venues/eigen_asb/client.py's header for the full build command).
EIGEN_ASB_BINARY_PATH=~/eigenwallet-core/target/release/examples/fetch_quotes_json

# Eigen ASB: 1 to route quote discovery through Tor (matches the real `swap`
# CLI's own default), 0 for direct clearnet (faster, verified to return the
# same live quotes -- see client.py's header for why this is the default).
EIGEN_ASB_USE_TOR=0
