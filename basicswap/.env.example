# Phase 1 poller config (basicswap/strategy/) — copy to `basicswap/.env` and source
# it, or export these directly, before running the poller. Nothing here is a secret
# except BASICSWAP_AUTH_PASSWORD if you set --client-auth-password on basicswap-run.

# BasicSwap's local JSON API — same host/port as the web UI itself (doc/api.md's
# curl examples say 12701, but that's stale/wrong for v0.18.8; verified live
# 2026-09-15 that /json/* is served on the web UI's own port, 12700).
BASICSWAP_API_URL=http://localhost:12700

# Only needed if basicswap-run was started with --client-auth-password.
BASICSWAP_AUTH_USER=
BASICSWAP_AUTH_PASSWORD=

BASICSWAP_REQUEST_TIMEOUT_SECONDS=10

# How often the poller re-checks the order book, in --loop mode.
BASICSWAP_POLL_INTERVAL_SECONDS=300

# Comma-separated FROM/TO pairs to observe. BTC/XMR is BasicSwap's flagship pair
# (ARCHITECTURE.md §6) — add more once Phase 1 has a read on this one.
BASICSWAP_PAIRS=xmr/btc

# Outside this git repo, alongside BasicSwap's own runtime data (ARCHITECTURE.md §2).
BASICSWAP_DB_PATH=~/coinswaps/basicswap_observations.db
